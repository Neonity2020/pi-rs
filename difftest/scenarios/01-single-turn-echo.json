{
	"name": "01-single-turn-echo",
	"description": "One user turn; assistant streams text deltas then stops. Verifies request shape, delta assembly, usage parsing, print-mode output and session persistence.",
	"model": "difftest/difftest-model",
	"prompt": "Say hi",
	"fixtureFiles": { "hello.txt": "hello world\n" },
	"turns": [
		{
			"assertRequest": {
				"model": "difftest-model",
				"stream": true,
				"lastMessageRole": "user"
			},
			"sse": [
				{ "choices": [{ "index": 0, "delta": { "role": "assistant", "content": "" }, "finish_reason": null }] },
				{ "choices": [{ "index": 0, "delta": { "content": "Hi" }, "finish_reason": null }] },
				{ "choices": [{ "index": 0, "delta": { "content": " there" }, "finish_reason": null }] },
				{
					"choices": [{ "index": 0, "delta": {}, "finish_reason": "stop" }],
					"usage": { "prompt_tokens": 12, "completion_tokens": 3, "total_tokens": 15 }
				}
			]
		}
	],
	"expect": { "exitCode": 0, "finalText": "Hi there" }
}
