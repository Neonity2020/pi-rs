  <script>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // ---------------------------------------------------------------- copy
    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.cssText = "position:fixed;top:0;left:0;opacity:0";
        document.body.appendChild(area);
        area.select();
        area.setSelectionRange(0, text.length);
        let ok = false;
        try {
          ok = document.execCommand("copy");
        } catch {
          ok = false;
        }
        area.remove();
        return ok;
      }
    }

    document.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-copy]");
      if (!button) return;

      const ok = await copyText(button.dataset.copy);
      if (!ok) return;

      const label = button.querySelector(".copy-label") || button;
      const original = label.textContent;
      label.textContent = "已复制";
      button.classList.add("copied");
      clearTimeout(button._copyTimer);
      button._copyTimer = setTimeout(() => {
        label.textContent = original;
        button.classList.remove("copied");
      }, 1500);
    });

    // -------------------------------------------------------------- reveal
    const revealItems = Array.from(document.querySelectorAll(".reveal"));

    if (reduceMotion.matches || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      document.documentElement.classList.add("reveal-ready");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
      );
      revealItems.forEach((item) => observer.observe(item));
    }

    // ------------------------------------------------------------- terminal
    const terminal = document.querySelector("[data-term]");

    if (terminal) {
      const lines = Array.from(terminal.querySelectorAll(".line"));
      const timers = [];
      let played = false;

      const stopTimers = () => {
        while (timers.length) clearTimeout(timers.pop());
      };

      const revealAll = () => {
        terminal.removeAttribute("data-anim");
        lines.forEach((line) => line.classList.add("on"));
      };

      const play = () => {
        stopTimers();
        if (reduceMotion.matches) {
          revealAll();
          return;
        }

        played = true;
        terminal.setAttribute("data-anim", "");
        lines.forEach((line) => line.classList.remove("on"));

        let at = 150;
        lines.forEach((line) => {
          timers.push(setTimeout(() => line.classList.add("on"), at));
          at += Number(line.dataset.delay || 260);
        });
        timers.push(
          setTimeout(() => terminal.removeAttribute("data-anim"), at + 200),
        );
      };

      if (!reduceMotion.matches) terminal.setAttribute("data-anim", "");

      if ("IntersectionObserver" in window) {
        const observer = new IntersectionObserver(
          (entries) => {
            if (!entries.some((entry) => entry.isIntersecting)) return;
            observer.disconnect();
            if (!played) play();
          },
          { threshold: 0.2 },
        );
        observer.observe(terminal);
      } else {
        revealAll();
      }

      document
        .querySelector("[data-replay]")
        ?.addEventListener("click", () => play());
    }

    // -------------------------------------------------------------- mosaic
    const mosaic = document.querySelector("[data-mosaic]");

    if (mosaic) {
      const colors = ["yellow", "coral", "blue", "mint", "violet", "pink"];

      mosaic.addEventListener("click", () => {
        mosaic.querySelectorAll(".tile").forEach((tile) => {
          colors.forEach((color) => tile.classList.remove(`c-${color}`));
          const pick = colors[Math.floor(Math.random() * colors.length)];
          tile.classList.add(`c-${pick}`);
        });

        mosaic.classList.remove("shuffled");
        void mosaic.offsetWidth;
        mosaic.classList.add("shuffled");
      });
    }
  </script>
