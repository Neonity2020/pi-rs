---
import BaseLayout from '../layouts/BaseLayout.astro';
import Nav from '../components/Nav.astro';
import Hero from '../components/Hero.astro';
import Stats from '../components/Stats.astro';
import Features from '../components/Features.astro';
import Providers from '../components/Providers.astro';
import Modes from '../components/Modes.astro';
import Compat from '../components/Compat.astro';
import Quickstart from '../components/Quickstart.astro';
import UseCases from '../components/UseCases.astro';
import Faq from '../components/Faq.astro';
import Cta from '../components/Cta.astro';
import Footer from '../components/Footer.astro';
---

<BaseLayout
	title="pi-rs — the terminal coding agent, compiled in Rust"
	description="pi-rs is a faithful Rust port of the pi coding agent: 10 provider APIs, 7 built-in tools, MCP with OAuth, session trees and a JSON-RPC surface — in one MIT-licensed binary."
>
	<Nav />
	<main id="main">
		<Hero />
		<Stats />
		<Features />
		<Providers />
		<Modes />
		<Compat />
		<Quickstart />
		<UseCases />
		<Faq />
		<Cta />
	</main>
	<Footer />
</BaseLayout>
