---
import Layout from "../layouts/Layout.astro";
import Hero from "../components/Hero.astro";
import Tape from "../components/Tape.astro";
import Stats from "../components/Stats.astro";
import Why from "../components/Why.astro";
import Tools from "../components/Tools.astro";
import Demo from "../components/Demo.astro";
import Arch from "../components/Arch.astro";
import Modes from "../components/Modes.astro";
import NotBuilt from "../components/NotBuilt.astro";
import Start from "../components/Start.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="pi-rs — 四块积木的 Rust coding agent"
  description="用 Rust 重写的极简 coding agent：read / write / edit / bash 四把工具、约 300 token 系统提示、严格单向的依赖链。没有 MCP，没有子代理，没有魔法。"
>
  <Hero />
  <Tape />
  <Stats />
  <Why />
  <Tools />
  <Demo />
  <Arch />
  <Modes />
  <NotBuilt />
  <Start />
  <Footer />

  <script>
    const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

    // ---------------------------------------------------------------- copy
    async function copyText(text) {
      try {
        await navigator.clipboard.writeText(text);
        return true;
      } catch {
        const area = document.createElement("textarea");
        area.value = text;
        area.setAttribute("readonly", "");
        area.style.cssText = "position:fixed;top:0;left:0;opacity:0";
        document.body.appendChild(area);
        area.select();
        area.setSelectionRange(0, text.length);
        let ok = false;
        try {
          ok = document.execCommand("copy");
        } catch {
          ok = false;
        }
        area.remove();
        return ok;
      }
    }

    document.addEventListener("click", async (event) => {
      const button = event.target.closest("[data-copy]");
      if (!button) return;

      const ok = await copyText(button.dataset.copy);
      if (!ok) return;

      const label = button.querySelector(".copy-label") || button;
      const original = label.textContent;
      label.textContent = "已复制";
      button.classList.add("copied");
      clearTimeout(button._copyTimer);
      button._copyTimer = setTimeout(() => {
        label.textContent = original;
        button.classList.remove("copied");
      }, 1500);
    });

    // -------------------------------------------------------------- reveal
    const revealItems = Array.from(document.querySelectorAll(".reveal"));

    if (reduceMotion.matches || !("IntersectionObserver" in window)) {
      revealItems.forEach((item) => item.classList.add("is-visible"));
    } else {
      document.documentElement.classList.add("reveal-ready");
      const observer = new IntersectionObserver(
        (entries) => {
          entries.forEach((entry) => {
            if (!entry.isIntersecting) return;
            entry.target.classList.add("is-visible");
            observer.unobserve(entry.target);
          });
        },
        { threshold: 0.12, rootMargin: "0px 0px -40px 0px" },
      );
      revealItems.forEach((item) => observer.observe(item));
    }
  </script>
</Layout>
