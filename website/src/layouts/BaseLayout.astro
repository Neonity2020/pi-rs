---
import '../styles/global.css';

interface Props {
	title: string;
	description: string;
	/** 404 pages must not be indexed and carry no canonical URL. */
	noindex?: boolean;
}

const { title, description, noindex = false } = Astro.props;

/** Directory-form builds serve `/path` from `/path/` — keep one canonical spelling. */
const canonicalPath = (pathname: string) =>
	pathname.endsWith('/') ? pathname : `${pathname}/`;

const canonical = Astro.site && !noindex ? new URL(canonicalPath(Astro.url.pathname), Astro.site) : undefined;
const base = import.meta.env.BASE_URL.endsWith('/')
	? import.meta.env.BASE_URL
	: `${import.meta.env.BASE_URL}/`;
const ogImage = Astro.site
	? new URL(`${base}og.png`, Astro.site)
	: new URL(`${base}og.png`, Astro.url);
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<title>{title}</title>
		<meta name="description" content={description} />
		<meta name="theme-color" content="#06080b" />
		<link rel="icon" type="image/svg+xml" href={`${base}favicon.svg`} />
		{canonical && <link rel="canonical" href={canonical} />}
		{noindex && <meta name="robots" content="noindex" />}

		<meta property="og:type" content="website" />
		<meta property="og:site_name" content="pi-rs" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical ?? Astro.url} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />

		<link rel="preconnect" href="https://fonts.googleapis.com" />
		<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
		<link
			rel="stylesheet"
			href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500;600&display=swap"
		/>
	</head>
	<body>
		<a class="skip-link" href="#main">Skip to content</a>
		<slot />
		<script>
			// scroll reveal — progressive enhancement only
			const items = document.querySelectorAll<HTMLElement>('.reveal');
			const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

			if (reduced || !('IntersectionObserver' in window)) {
				items.forEach((el) => el.classList.add('is-visible'));
			} else {
				const io = new IntersectionObserver(
					(entries) => {
						for (const entry of entries) {
							if (entry.isIntersecting) {
								entry.target.classList.add('is-visible');
								io.unobserve(entry.target);
							}
						}
					},
					{ rootMargin: '0px 0px -12% 0px', threshold: 0.12 },
				);
				items.forEach((el) => io.observe(el));
			}
		</script>
	</body>
</html>
