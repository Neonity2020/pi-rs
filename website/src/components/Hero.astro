---
const repo = 'https://github.com/Neonity2020/pi-os';

const highlights = [
	'MIT licensed',
	'Single static binary',
	'No Node runtime',
	'10 provider APIs',
];
---

<section class="hero">
	<div class="hero__grid-bg grid-bg" aria-hidden="true"></div>
	<div class="hero__glow" aria-hidden="true"></div>

	<div class="container hero__inner">
		<div class="hero__copy">
			<span class="badge badge--accent hero__badge">
				<span class="hero__pulse" aria-hidden="true"></span>
				Rust port of the pi coding agent
			</span>

			<h1 class="hero__title">
				The terminal coding agent, <span class="hero__accent">compiled in Rust.</span>
			</h1>

			<p class="hero__lede">
				pi-rs is a faithful Rust port of <a href="https://pi.dev" target="_blank" rel="noreferrer">pi</a> — the
				terminal-first coding agent. Same session files, same wire format, every provider you already pay for,
				one binary that starts before your coffee cools.
			</p>

			<div class="hero__actions">
				<a class="btn btn--primary btn--lg" href="#quickstart">
					Install pi-rs
					<svg viewBox="0 0 16 16" width="16" height="16" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
						<path d="M6 3l5 5-5 5"></path>
					</svg>
				</a>
				<a class="btn btn--ghost btn--lg" href={repo} target="_blank" rel="noreferrer">
					<svg viewBox="0 0 16 16" width="16" height="16" fill="currentColor" aria-hidden="true">
						<path
							d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
						></path>
					</svg>
					Star on GitHub
				</a>
			</div>

			<ul class="hero__facts">
				{
					highlights.map((item) => (
						<li>
							<svg viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
								<path d="M3 8.5l3.2 3.2L13 5"></path>
							</svg>
							{item}
						</li>
					))
				}
			</ul>
		</div>

		<div class="hero__visual">
			<div class="term">
				<div class="term__bar">
					<span class="term__dots" aria-hidden="true"><i></i><i></i><i></i></span>
					<span class="term__title">pi-rs — ~/projects/api-gateway</span>
				</div>
				<div class="term__body">
					<p class="term__line">
						<span class="term__prompt">❯</span>
						<span class="term__cmd">pi-rs -p "find every TODO in src and group them by module"</span>
					</p>
					<p class="term__line term__line--dim">
						<span class="term__tag">model</span> mimo/mimo-v2.6-pro <span class="term__tag">thinking</span> high
					</p>
					<p class="term__line term__line--dim">
						<span class="term__tag">tool</span> grep(pattern="TODO", path="src")
					</p>
					<p class="term__line">
						<span class="term__ok">✓</span> 14 matches across 7 files
					</p>
					<p class="term__line term__line--dim">
						<span class="term__tag">tokens</span> 1,284 in / 512 out <span class="term__tag">done</span> 11.4s
					</p>
					<p class="term__line">
						<span class="term__prompt">❯</span>
						<span class="term__caret"></span>
					</p>
				</div>
			</div>

			<div class="hero__chip hero__chip--one" aria-hidden="true">1.4 ms startup</div>
			<div class="hero__chip hero__chip--two" aria-hidden="true">MCP · OAuth</div>
		</div>
	</div>
</section>

<style>
	.hero {
		position: relative;
		padding-block: clamp(3.5rem, 8vw, 6.5rem) clamp(3rem, 6vw, 5rem);
		overflow: hidden;
	}

	.hero__grid-bg {
		position: absolute;
		inset: -20% 0 auto;
		height: 620px;
		z-index: -2;
	}

	.hero__glow {
		position: absolute;
		top: -18rem;
		left: 50%;
		width: 62rem;
		height: 46rem;
		transform: translateX(-50%);
		z-index: -1;
		background: radial-gradient(closest-side, rgb(126 231 135 / 16%), transparent 72%);
		filter: blur(20px);
	}

	.hero__inner {
		display: grid;
		grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
		gap: clamp(2.5rem, 5vw, 4rem);
		align-items: center;
	}

	.hero__badge {
		margin-bottom: 1.35rem;
	}

	.hero__pulse {
		width: 0.45rem;
		height: 0.45rem;
		border-radius: 50%;
		background: currentColor;
		box-shadow: 0 0 0 0 currentColor;
		animation: pulse 2.4s var(--ease) infinite;
	}

	@keyframes pulse {
		0% {
			box-shadow: 0 0 0 0 rgb(126 231 135 / 55%);
		}
		70% {
			box-shadow: 0 0 0 0.5rem rgb(126 231 135 / 0%);
		}
		100% {
			box-shadow: 0 0 0 0 rgb(126 231 135 / 0%);
		}
	}

	.hero__title {
		font-size: clamp(2.4rem, 5.6vw, 3.9rem);
		letter-spacing: -0.035em;
		font-weight: 680;
	}

	.hero__accent {
		background: linear-gradient(100deg, var(--accent) 10%, var(--blue) 90%);
		-webkit-background-clip: text;
		background-clip: text;
		color: transparent;
	}

	.hero__lede {
		margin-top: 1.25rem;
		max-width: 34rem;
		color: var(--text-muted);
		font-size: clamp(1rem, 1.6vw, 1.12rem);
	}

	.hero__lede a {
		color: var(--text);
		text-decoration: underline;
		text-decoration-color: color-mix(in srgb, var(--accent) 55%, transparent);
		text-underline-offset: 3px;
	}

	.hero__actions {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem;
		margin-top: 2rem;
	}

	.hero__facts {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1.4rem;
		margin-top: 1.75rem;
		font-size: 0.87rem;
		color: var(--text-dim);
	}

	.hero__facts li {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
	}

	.hero__facts svg {
		color: var(--accent);
	}

	/* terminal ------------------------------------------------------- */

	.hero__visual {
		position: relative;
	}

	.term {
		border: 1px solid var(--border-strong);
		border-radius: var(--radius-lg);
		background: color-mix(in srgb, var(--bg-elev) 92%, transparent);
		box-shadow: var(--shadow);
		overflow: hidden;
	}

	.term__bar {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		padding: 0.7rem 1rem;
		border-bottom: 1px solid var(--border);
		background: var(--surface);
	}

	.term__dots {
		display: inline-flex;
		gap: 0.35rem;
	}

	.term__dots i {
		width: 0.62rem;
		height: 0.62rem;
		border-radius: 50%;
		background: var(--border-strong);
	}

	.term__dots i:nth-child(1) {
		background: #ff5f57;
	}

	.term__dots i:nth-child(2) {
		background: #febc2e;
	}

	.term__dots i:nth-child(3) {
		background: #28c840;
	}

	.term__title {
		font-family: var(--font-mono);
		font-size: 0.78rem;
		color: var(--text-dim);
		overflow: hidden;
		text-overflow: ellipsis;
		white-space: nowrap;
	}

	.term__body {
		padding: 1.1rem 1.15rem 1.3rem;
		font-family: var(--font-mono);
		font-size: 0.82rem;
		line-height: 1.85;
	}

	.term__line {
		color: var(--text);
		word-break: break-word;
	}

	.term__line--dim {
		color: var(--text-dim);
	}

	.term__prompt {
		color: var(--accent);
		margin-right: 0.5rem;
	}

	.term__cmd {
		color: var(--text);
	}

	.term__tag {
		display: inline-block;
		margin-right: 0.4rem;
		padding: 0 0.4rem;
		border-radius: 5px;
		background: var(--surface-strong);
		color: var(--text-muted);
		font-size: 0.75rem;
	}

	.term__ok {
		color: var(--accent);
		margin-right: 0.4rem;
	}

	.term__caret {
		display: inline-block;
		width: 0.5rem;
		height: 1rem;
		vertical-align: text-bottom;
		background: var(--accent);
		animation: blink 1.1s steps(2, start) infinite;
	}

	@keyframes blink {
		50% {
			opacity: 0;
		}
	}

	.hero__chip {
		position: absolute;
		padding: 0.4rem 0.8rem;
		border-radius: 999px;
		border: 1px solid var(--border-strong);
		background: color-mix(in srgb, var(--bg-elev) 88%, transparent);
		backdrop-filter: blur(8px);
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: var(--text-muted);
		box-shadow: var(--shadow-sm);
	}

	.hero__chip--one {
		top: -0.9rem;
		right: 1rem;
	}

	.hero__chip--two {
		bottom: -0.9rem;
		left: 1.4rem;
	}

	@media (max-width: 960px) {
		.hero__inner {
			grid-template-columns: minmax(0, 1fr);
		}

		.hero__visual {
			order: -1;
		}

		.hero__lede {
			max-width: 100%;
		}
	}
</style>
