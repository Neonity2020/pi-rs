---
const stats = [
	{ value: '10', label: 'provider wire APIs', hint: 'OpenAI · Anthropic · Bedrock · Vertex · Gemini · Mistral · Azure' },
	{ value: '7', label: 'built-in tools', hint: 'read · write · edit · bash · grep · find · ls' },
	{ value: '33/33', label: 'RPC commands', hint: 'full session-tree and agent control over the wire' },
	{ value: '0', label: 'Node runtime deps', hint: 'one static binary, MIT licensed' },
];
---

<section class="stats">
	<div class="container">
		<dl class="stats__grid reveal">
			{
				stats.map((stat) => (
					<div class="stats__item">
						<dt class="stats__value">{stat.value}</dt>
						<dd class="stats__label">{stat.label}</dd>
						<p class="stats__hint">{stat.hint}</p>
					</div>
				))
			}
		</dl>
	</div>
</section>

<style>
	.stats {
		border-block: 1px solid var(--border);
		background: color-mix(in srgb, var(--bg-elev) 45%, transparent);
	}

	.stats__grid {
		display: grid;
		grid-template-columns: repeat(4, minmax(0, 1fr));
	}

	.stats__item {
		padding: 2rem 1.5rem;
		border-left: 1px solid var(--border);
	}

	.stats__item:first-child {
		border-left: 0;
		padding-left: 0;
	}

	.stats__value {
		font-size: clamp(1.9rem, 3.4vw, 2.6rem);
		font-weight: 680;
		letter-spacing: -0.03em;
		line-height: 1;
		color: var(--accent);
	}

	.stats__label {
		margin-top: 0.5rem;
		font-size: 0.92rem;
		font-weight: 550;
	}

	.stats__hint {
		margin-top: 0.35rem;
		font-size: 0.78rem;
		color: var(--text-dim);
		line-height: 1.5;
	}

	@media (max-width: 860px) {
		.stats__grid {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.stats__item {
			border-left: 0;
			border-top: 1px solid var(--border);
			padding: 1.5rem 1rem;
		}

		.stats__item:nth-child(odd) {
			padding-left: 0;
		}
	}
</style>
