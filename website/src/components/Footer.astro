---
const repo = 'https://github.com/Neonity2020/pi-os';
const upstream = 'https://pi.dev';

interface FooterLink {
	label: string;
	href: string;
	external?: boolean;
}

interface FooterColumn {
	title: string;
	links: FooterLink[];
}

const columns: FooterColumn[] = [
	{
		title: 'Product',
		links: [
			{ label: 'Features', href: '#features' },
			{ label: 'Providers', href: '#providers' },
			{ label: 'Run modes', href: '#modes' },
			{ label: 'Install', href: '#quickstart' },
			{ label: 'FAQ', href: '#faq' },
		],
	},
	{
		title: 'Resources',
		links: [
			{ label: 'README', href: repo, external: true },
			{ label: 'docs/', href: `${repo}/tree/main/docs`, external: true },
			{ label: 'User guide', href: `${repo}/tree/main/docs/user`, external: true },
			{ label: 'Operations', href: `${repo}/tree/main/docs/operations`, external: true },
			{ label: 'Changelog', href: `${repo}/blob/main/CHANGELOG.md`, external: true },
		],
	},
	{
		title: 'Project',
		links: [
			{ label: 'GitHub', href: repo, external: true },
			{ label: 'Issues', href: `${repo}/issues`, external: true },
			{ label: 'Upstream pi', href: upstream, external: true },
			{ label: 'License (MIT)', href: `${repo}/blob/main/LICENSE`, external: true },
		],
	},
];
---

<footer class="footer">
	<div class="container">
		<div class="footer__top">
			<div class="footer__brand">
				<a class="footer__logo" href="#top">
					<span class="footer__mark" aria-hidden="true">
						<svg viewBox="0 0 24 24" width="20" height="20" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M3 17l6-6 4 4 8-8" />
							<path d="M14 7h7v7" />
						</svg>
					</span>
					pi-rs
				</a>
				<p>
					A Rust port of the pi coding agent — same semantics, same session files, native speed.
				</p>
				<span class="badge">v0.1 · MIT</span>
			</div>

			{
				columns.map((column) => (
					<nav class="footer__col" aria-label={column.title}>
						<h2>{column.title}</h2>
						<ul>
							{column.links.map((link) => (
								<li>
									<a href={link.href} target={link.external ? '_blank' : undefined} rel={link.external ? 'noreferrer' : undefined}>
										{link.label}
									</a>
								</li>
							))}
						</ul>
					</nav>
				))
			}
		</div>

		<div class="footer__bottom">
			<p>Built in Rust by the pi-rs contributors. Not affiliated with upstream pi.</p>
			<p class="footer__meta">
				<span class="mono">rustc 2024</span> · <span class="mono">MIT</span> ·
				<span class="mono">pi.dev</span> compatible
			</p>
		</div>
	</div>
</footer>

<style>
	.footer {
		border-top: 1px solid var(--border);
		padding-block: clamp(2.5rem, 5vw, 4rem) 2rem;
		background: color-mix(in srgb, var(--bg-elev) 40%, transparent);
	}

	.footer__top {
		display: grid;
		grid-template-columns: minmax(0, 1.6fr) repeat(3, minmax(0, 1fr));
		gap: 2rem;
	}

	.footer__logo {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		font-weight: 650;
		letter-spacing: -0.02em;
	}

	.footer__mark {
		display: grid;
		place-items: center;
		width: 1.8rem;
		height: 1.8rem;
		border-radius: 8px;
		background: var(--accent-soft);
		color: var(--accent);
	}

	.footer__brand p {
		margin-block: 0.9rem 0.9rem;
		max-width: 22rem;
		color: var(--text-muted);
		font-size: 0.9rem;
	}

	.footer__col h2 {
		font-size: 0.78rem;
		text-transform: uppercase;
		letter-spacing: 0.12em;
		color: var(--text-dim);
		margin-bottom: 0.9rem;
	}

	.footer__col ul {
		display: grid;
		gap: 0.5rem;
	}

	.footer__col a {
		font-size: 0.9rem;
		color: var(--text-muted);
		transition: color 0.2s var(--ease);
	}

	.footer__col a:hover {
		color: var(--accent);
	}

	.footer__bottom {
		display: flex;
		flex-wrap: wrap;
		gap: 0.75rem 1.5rem;
		justify-content: space-between;
		margin-top: 3rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		font-size: 0.82rem;
		color: var(--text-dim);
	}

	.footer__meta {
		display: flex;
		gap: 0.5rem;
	}

	@media (max-width: 860px) {
		.footer__top {
			grid-template-columns: repeat(2, minmax(0, 1fr));
		}

		.footer__brand {
			grid-column: 1 / -1;
		}
	}
</style>
