# MiMo Token Plan 国内订阅密钥（从订阅页面获取）。
MIMO_API_KEY=

# 可选：以订阅页面提供的 OpenAI 兼容地址为准。
# MIMO_BASE_URL=https://token-plan-cn.xiaomimimo.com/v1

# 可选：使用 OpenAI 或其他兼容 provider 时的密钥。
# OPENAI_API_KEY=

# 可选：OpenRouter Mammoth 决策技能使用的密钥。
# OPENROUTER_API_KEY=

# 可选：自定义配置和会话目录。
# PI_RS_AGENT_DIR=/path/to/agent
# PI_RS_SESSION_DIR=/path/to/sessions
